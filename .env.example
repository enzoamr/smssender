# Copiez ce fichier en .env.local et renseignez vos valeurs.
# Tant que ces variables sont vides, l'app tourne en mode démo (provider stub,
# store en mémoire) — pratique pour développer l'UI sans comptes externes.

# === Firebase — SDK client (exposé au navigateur, c'est normal) ===
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === Firebase Admin — compte de service (serveur uniquement, JAMAIS exposé) ===
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Conservez les \n échappés ; ils sont reconvertis côté serveur.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# === Twilio (Programmable Messaging) ===
# Account SID : commence TOUJOURS par "AC" (pas par "SK") — page d'accueil de la console.
TWILIO_ACCOUNT_SID=
# Auth simple : l'Auth Token (page d'accueil de la console).
TWILIO_AUTH_TOKEN=
# OU auth par API Key (recommandé en prod) : laisser TWILIO_AUTH_TOKEN vide et remplir :
#   TWILIO_API_KEY_SID    -> commence par "SK"
#   TWILIO_API_KEY_SECRET -> le secret affiché une seule fois à la création
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# URL publique appelée par Twilio à chaque changement de statut.
# Doit correspondre EXACTEMENT à l'URL configurée (sert aussi à valider la signature) :
TWILIO_STATUS_CALLBACK_URL=https://votre-domaine.com/api/webhooks/twilio
# Optionnel : Messaging Service SID (pool d'expéditeurs A2P). Si défini, il prime
# sur le sender ID/numéro envoyé par l'app.
TWILIO_MESSAGING_SERVICE_SID=

# === Stripe (Billing) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# === Session (serveur) ===
# Clé symétrique HS256 pour signer les cookies de session (Base64, 32+ octets).
# Générez-la avec : openssl rand -base64 32
SESSION_SECRET=

# === Administration ===
# Emails autorisés à accéder à la console d'administration (/admin),
# séparés par des virgules. Ex : admin@exemple.com,patron@exemple.com
ADMIN_EMAILS=

# === API publique (phase 2) ===
# Clé de démo acceptée par /api/v1 tant que le stockage des clés n'est pas branché.
DEMO_API_KEY=sk_test_demo
